        {
          "ChapterID": "Q2001_Start",
          "iQuestOffered": 0,
          "iQuestRequiredToUnlock": 0,
          "strNextPermanentChapterID": "Q2001_ACTIVE_PERM",
          "Steps": [
            {
              "Speaker": "타린",
              "Text": "헉..헉..\n큰일이야.. 정말 큰일이야..!",
              "strActionCommand": "",
              "actionTiming": ""
            },
            {
              "Speaker": "타린",
              "Text": "리차드집 근처에서..\n아이 하나가 사라졌어!",
              "strActionCommand": "",
              "actionTiming": ""
            },
            {
              "Speaker": "타린",
              "Text": "링크, 네가 있어서 다행이야.\n나 혼자선 어찌할 수가 없었어.",
              "strActionCommand": "",
              "actionTiming": ""
            },
            {
              "Speaker": "타린",
              "Text": "네가 집 안을 좀 살펴봐 줘.\n아이를 찾을 수 있는 건 너뿐이야.",
              "strActionCommand": "",
              "actionTiming": ""
            },
            {
              "Speaker": "타린",
              "Text": "지금 말로 설명할 시간이 없어.\n리차드네 집으로 바로 가야 해!",
              "strActionCommand": "On_TarinEvent_End",
              "actionTiming": "ON_FINISH"
            }
          ]
        },
        {
          "ChapterID": "Q2001_ACTIVE_PERM",
          "iQuestOffered": 0,
          "iQuestRequiredToUnlock": 0,
          "strNextPermanentChapterID": "Wait",
          "Steps": [
            {
              "Speaker": "타린",
              "Text": "여기야... 리차드네 집.\n밖에서 보기엔 그냥 평범해 보이지?",
              "strActionCommand": "",
              "actionTiming": ""
            },
            {
              "Speaker": "타린",
              "Text": "집 안을 제대로 본 사람은 아직 없어.\n다들 당황해서 말이지.",
              "strActionCommand": "",
              "actionTiming": ""
            },
            {
              "Speaker": "타린",
              "Text": "링크, 네가 안을 한 번 살펴봐 줘.\n무슨 단서라도 있을지 몰라.",
              "strActionCommand": "",
              "actionTiming": ""
            }
