{
  "NPCScripts": [
    {
      "ModelID": "NPC_Kid_Red",
      "Chapters": [
        {
          "ChapterID": "Ending_START",
          "iQuestOffered": 0,
          "iQuestRequiredToUnlock": 0, 
          "strNextPermanentChapterID": "",
          "Steps": [
            {
              "Speaker": "건희",
              "Text": "우씨... 여긴 어떻게 찾았어?\n나만의 비밀기지란 말이야!",
              "strActionCommand": "",
              "actionTiming": "ON_FINISH"
            },
            {
              "Speaker": "건희",
              "Text": "도와달라 한 적 없어!\n내 친구도 쫓아내고 엉망으로 만들었잖아!",
              "strActionCommand": "",
              "actionTiming": "ON_START"
            },
            {
              "Speaker": "링크",
              "Text": "오해하게 해서 미안해. 널 지키려던 거였어.",
              "strActionCommand": "",
              "actionTiming": "ON_START"
            },
            {
              "Speaker": "건희",
              "Text": "이런 게 무슨 방범대야!\n내 친구랑 비밀기지 다 돌려내!",
              "strActionCommand": "",
              "actionTiming": "ON_FINISH"
            },
            {
              "Speaker": "링크",
              "Text": "미안하지만 가야 해.\n밖으로 나가면 사람들을 만날 수 있어.",
              "strActionCommand": "",
              "actionTiming": "ON_START"
            },
            {
              "Speaker": "건희",
              "Text": "흥! 앞으로 말 걸지 마. 나 먼저 갈 거야!",
              "strActionCommand": "",
              "actionTiming": "ON_FINISH"
            },
            {
              "Speaker": "링크",
              "Text": "잠깐, 건희야! 혼자 가면 위험해!\n(어서 쫓아가자.)",
              "strActionCommand": "End_RedKid",
              "actionTiming": "ON_FINISH"
            }
           
          ]
        }
      ]
    }
  ]
}